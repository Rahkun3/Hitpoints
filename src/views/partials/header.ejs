<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/">
      <img src="/assets/logo.png" alt="hitpoints.eu logo" width="36" height="36" />
      hitpoints.eu
    </a>
    <ul class="nav-links">
      <li><a href="/" class="<%= active === 'home' ? 'active' : '' %>">Universes</a></li>
      <% universeList.forEach(function (u) { %>
      <li><a href="/wiki/<%= u.id %>" class="<%= active === u.id ? 'active' : '' %>"><%= u.name %></a></li>
      <% }) %>
    <% if (typeof admin !== "undefined" && admin) { %>
      <li><a href="/admin">Admin</a></li>
    <% } %>
    </ul>
    <div class="search-stub" role="search" aria-label="Search (stub)">
      <span aria-hidden="true">⌕</span>
      Search universes &amp; articles…
      <kbd>/</kbd>
    </div>
  </div>
</header>
