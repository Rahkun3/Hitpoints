<%- include("../partials/head") %>
<main class="admin-login wrap">
  <a class="brand" href="/" style="margin-bottom: 1.5rem;">
    <img src="/assets/logo.png" alt="" width="36" height="36" />
    hitpoints.eu
  </a>
  <div class="admin-card">
    <p class="hero-eyebrow">Admin</p>
    <h1>Sign in</h1>
    <p class="muted">Edit wiki articles as Markdown. No HTML required.</p>
    <% if (error) { %>
    <p class="admin-error">Wrong username or password.</p>
    <% } %>
    <form method="post" action="/admin/login" class="admin-form">
      <input type="hidden" name="next" value="<%= next %>" />
      <label>Username
        <input type="text" name="username" autocomplete="username" required />
      </label>
      <label>Password
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button class="btn btn-primary" type="submit">Sign in</button>
    </form>
  </div>
</main>
</body>
</html>
